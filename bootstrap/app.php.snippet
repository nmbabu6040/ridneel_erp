<?php
/**
 * LARAVEL 11 / 12 SETUP ONLY
 * -----------------------------------------------------------------
 * This is NOT a full bootstrap/app.php — it shows exactly what to
 * add inside the ->withMiddleware() closure of your existing
 * bootstrap/app.php (generated by `composer create-project`).
 *
 * Your file already looks like this:
 *
 *   return Application::configure(basePath: dirname(__DIR__))
 *       ->withRouting(...)
 *       ->withMiddleware(function (Middleware $middleware) {
 *           //  <-- ADD THE TWO BLOCKS BELOW INSIDE HERE
 *       })
 *       ->withExceptions(function (Exceptions $exceptions) {
 *           //
 *       })->create();
 */

// 1) Register the named middleware alias used throughout routes/web.php
//    (e.g. ->middleware('permission:users.view')).
$middleware->alias([
    'permission' => \App\Http\Middleware\CheckPermission::class,
]);

// 2) Push SetLocale onto the web middleware group so every web request
//    gets the correct app()->getLocale() before rendering. This is the
//    ONE step that actually makes the bn/en language switcher work —
//    skipping it is why clicking "বাংলা" silently does nothing: the
//    switch route sets session('locale') correctly, but with no
//    SetLocale middleware running on the next request, nothing ever
//    reads it back and calls app()->setLocale().
$middleware->web(append: [
    \App\Http\Middleware\SetLocale::class,
]);
